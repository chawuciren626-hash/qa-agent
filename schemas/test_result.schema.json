{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestExecutionResult",
  "type": "object",
  "required": ["run_id", "status", "started_at", "finished_at", "summary", "cases"],
  "properties": {
    "run_id": { "type": "string" },
    "status": { "enum": ["completed", "blocked", "failed"] },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "block_reason": { "type": "string" },
    "summary": { "type": "object" },
    "cases": { "type": "array" }
  }
}
