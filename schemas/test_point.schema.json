{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestPoint",
  "type": "object",
  "required": [
    "id",
    "module",
    "feature",
    "description",
    "risk",
    "coverage_type",
    "source",
    "rule_ids"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "module": {
      "type": "string"
    },
    "feature": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "risk": {
      "type": "string",
      "enum": [
        "高",
        "中",
        "低"
      ]
    },
    "coverage_type": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string"
    },
    "rule_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "end": {
      "type": "string",
      "enum": [
        "web",
        "web_admin",
        "app",
        "miniprogram",
        "desktop",
        "api",
        ""
      ],
      "description": "所属端。空串=未指定（兼容旧产物）；来源未说明时不推断。"
    },
    "execution_layer": {
      "enum": [
        "ui",
        "api",
        "both"
      ]
    },
    "operation_id": {
      "type": "string"
    }
  }
}
