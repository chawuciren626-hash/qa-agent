{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionPlan",
  "type": "object",
  "required": ["run_id", "source", "cases", "execution_policy", "design_gate"],
  "properties": {
    "run_id": { "type": "string" },
    "source": { "type": "string" },
    "design_gate": {
      "type": "object", "required": ["version", "run_id", "status", "case_ids", "files"],
      "properties": {
        "version": { "const": 1 }, "run_id": { "type": "string" }, "status": { "const": "passed" },
        "case_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "files": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["path", "sha256"], "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } }
      }
    },
    "selection": { "type": ["object", "null"] },
    "manual_pending": { "type": "array", "items": { "type": "object", "required": ["case_id", "status"], "properties": { "case_id": { "type": "string" }, "status": { "const": "pending_manual" }, "title": { "type": "string" } } } },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "title", "execution_contract"],
        "properties": {
          "case_id": { "type": "string" },
          "title": { "type": "string" },
          "asset_refs": { "type": "array" },
          "execution_contract": {
            "type": "object",
            "required": ["data_isolation", "setup", "assertion_mode", "cleanup_required"],
            "properties": {
              "data_isolation": { "enum": ["read_only", "isolated", "shared"] },
              "setup": { "type": "array", "items": { "type": "string" } },
              "assertion_mode": { "type": "array", "items": { "enum": ["dynamic_ui", "dom_state", "navigation", "api_response", "storage_state"] } },
              "cleanup_required": { "type": "boolean" }
            }
          }
        }
      }
    },
    "execution_policy": { "type": "object", "properties": {
      "global_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
      "preflight_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 }
    } }
  }
}
