{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "API execution plan",
  "type": "object",
  "required": ["version", "scope", "scenarios"],
  "properties": {
    "version": {"const": 1},
    "concurrency": {"type":"integer","minimum":1,"maximum":4},
    "timeout_ms": {"type":"integer","minimum":100,"maximum":60000},
    "interval_ms": {"type":"integer","minimum":0,"maximum":5000},
    "max_duration_ms": {"type":"integer","minimum":1000,"maximum":600000},
    "max_response_bytes": {"type":"integer","minimum":1,"maximum":1048576},
    "scope": {"type":"array","minItems":1,"maxItems":10,"items":{"type":"object","required":["url","source_path","quote"],"properties":{"url":{"type":"string","minLength":1},"source_path":{"type":"string"},"quote":{"type":"string","minLength":1}}}},
    "write_authorization": {"$ref":"#/definitions/source"},
    "scenarios": {"type":"array","minItems":1,"maxItems":100,"items":{
      "type":"object","required":["scenario_id","case_id","expected","source_refs","steps"],
      "properties":{
        "scenario_id":{"$ref":"#/definitions/id"},"case_id":{"type":"string","minLength":1},"expected":{"type":"string","minLength":1},
        "source_refs":{"type":"array","minItems":1,"items":{"$ref":"#/definitions/source"}},
        "resources":{"type":"array","uniqueItems":true,"maxItems":40,"items":{"type":"string","pattern":"^[A-Za-z0-9_.:-]{1,100}$"}},
        "depends_on":{"type":"array","uniqueItems":true,"items":{"$ref":"#/definitions/id"}},
        "steps":{"type":"array","minItems":1,"maxItems":30,"items":{
          "type":"object","required":["request_id","method","url","assertions"],
          "properties":{
            "request_id":{"$ref":"#/definitions/id"},"method":{"enum":["GET","HEAD","OPTIONS","POST","PUT","PATCH","DELETE"]},"url":{"type":"string","minLength":1},
            "headers":{"type":"object","additionalProperties":{"type":"string"}},"query":{"type":"object"},"path_params":{"type":"object"},"form":{"type":"object"},"json":{},"side_effect":{"type":"boolean"},"cleanup_of":{"$ref":"#/definitions/id"},
            "auth":{"type":"object","required":["type"],"properties":{"type":{"enum":["bearer","basic","api_key","cookie"]},"ref":{"type":"string"},"credential_key":{"$ref":"#/definitions/id"},"name":{"type":"string"},"in":{"enum":["header","query"]}}},
            "assertions":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"object","required":["type"],"properties":{"type":{"enum":["status","content_type","equals","exists","type","schema","range","length","contains"]},"path":{"type":"string"},"value":{},"min":{"type":"number"},"max":{"type":"number"}}}},
            "extract":{"type":"array","maxItems":30,"items":{"type":"object","required":["name","path"],"properties":{"name":{"$ref":"#/definitions/id"},"path":{"type":"string"}}}}
          }
        }}
      }
    }}
  },
  "definitions": {
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
    "source":{"type":"object","required":["source_path","quote"],"properties":{"source_path":{"type":"string","minLength":1},"quote":{"type":"string","minLength":1}}}
  }
}
