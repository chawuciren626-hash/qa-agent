{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestCase",
  "type": "object",
  "required": ["case_id", "title", "priority", "type", "preconditions", "steps", "expected", "automation_feasible", "related_test_point", "design_contract"],
  "properties": {
    "case_id": { "type": "string" },
    "title": { "type": "string" },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "type": { "type": "string" },
    "preconditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "test_data": { "type": "object" },
    "steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expected": { "type": "string" },
    "automation_feasible": { "type": "boolean" },
    "related_test_point": { "type": "string" },
    "design_contract": {
      "type": "object",
      "required": ["basis", "assumptions", "data_checks"],
      "properties": {
        "basis": { "type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["source", "rule", "status", "rule_id"],
          "properties": { "rule_id": { "type": "string", "minLength": 1 }, "source": { "type": "string", "minLength": 1 }, "rule": { "type": "string", "minLength": 1 }, "status": { "enum": ["confirmed", "pending", "conflicted"] } }
        } },
        "assumptions": { "type": "array", "items": {
          "type": "object", "required": ["statement", "status"],
          "properties": { "statement": { "type": "string", "minLength": 1 }, "status": { "enum": ["pending", "confirmed", "rejected"] }, "confirmation_ref": { "type": "string", "minLength": 1 } },
          "allOf": [{ "if": { "properties": { "status": { "const": "confirmed" } } }, "then": { "required": ["confirmation_ref"] } }]
        } },
        "data_checks": { "type": "array", "items": {
          "oneOf": [
            { "type": "object", "required": ["kind", "key", "unit", "expected"], "properties": {
              "kind": { "const": "length" }, "key": { "type": "string", "minLength": 1 }, "unit": { "enum": ["code_points", "utf16", "utf8_bytes", "graphemes"] }, "expected": { "type": "integer", "minimum": 0 }
            } },
            { "type": "object", "required": ["kind", "currency", "terms", "total_key"], "properties": {
              "kind": { "const": "minor_unit_sum" }, "currency": { "type": "string", "minLength": 1 }, "total_key": { "type": "string", "minLength": 1 },
              "terms": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["key", "sign"], "properties": { "key": { "type": "string", "minLength": 1 }, "sign": { "enum": [1, -1] } } } }
            } }
          ]
        } }
      }
    },
    "asset_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "properties": { "id": { "type": "string" }, "version": { "type": "string" } }
      }
    },
    "execution_contract": {
      "type": "object",
      "properties": {
        "data_isolation": { "enum": ["read_only", "isolated", "shared"] },
        "setup": { "type": "array", "items": { "type": "string" } },
        "assertion_mode": { "type": "array", "items": { "enum": ["dynamic_ui", "dom_state", "navigation", "api_response", "storage_state"] } },
        "cleanup_required": { "type": "boolean" }
      }
    },
    "execution_metadata": {
      "type": "object",
      "properties": {
        "modules": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "risk_level": { "enum": ["high", "medium", "low", "高", "中", "低"] },
        "execution_cost": { "enum": ["low", "medium", "high"] },
        "data_impact": { "enum": ["read_only", "isolated", "shared"] },
        "environment_dependencies": { "type": "array", "items": { "type": "string" } },
        "automation_maturity": { "enum": ["stable", "candidate", "manual_only"] },
        "estimated_duration_ms": { "type": "number", "minimum": 1 }
      }
    }
  }
}
