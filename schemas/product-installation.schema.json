{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "installation_id", "layout", "root", "project_id", "paths"],
  "properties": {
    "version": {"const": 1},
    "installation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "layout": {"enum": ["existing", "unified"]},
    "root": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
    "paths": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "host_executable", "host_data", "qa_data", "desktop_profile", "workspaces", "node"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "host_executable": {"type": "string", "minLength": 1},
        "host_data": {"type": "string", "minLength": 1},
        "qa_data": {"type": "string", "minLength": 1},
        "desktop_profile": {"type": "string", "minLength": 1},
        "workspaces": {"type": "string", "minLength": 1},
        "node": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "browsers": {"type": "string", "minLength": 1}
      }
    }
  }
}
